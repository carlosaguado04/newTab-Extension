{
  "manifest_version": 3,
  "name": "New Tab",
  "version": "1.0",
  "description": "Speed dial + bookmarklets, no CSP fuckery",
  "chrome_url_overrides": { "newtab": "index.html" },
  "permissions": ["bookmarks", "activeTab", "tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>", "https://v6.exchangerate-api.com/*"],
  "background": { "service_worker": "bg.js" },
  "web_accessible_resources": [{ "resources": ["index.html"], "matches": ["<all_urls>"] }]
}